class CashFlowSimulator:
    def __init__(self, user_profile, events, exchange_rates):
        self.user_id = user_profile.get("user_id")
        self.home_currency = user_profile.get("home_currency", "USD")
        self.available_balance = float(user_profile.get("available_balance", 0.0))
        self.min_balance = float(user_profile.get("minimum_balance_to_keep", 0.0))
        self.events = [e for e in events if e.get("user_id") == self.user_id]
        self.rates = exchange_rates

    def convert_currency(self, amount, currency, date_str):
        if not amount or currency == self.home_currency:
            return float(amount or 0.0)
        key = (date_str, currency, self.home_currency)
        rate = self.rates.get(key, 1.0)
        return float(amount) * rate

    def simulate(self, start_date, additional_outflows=None, disabled_events=None, reduced_events=None):
        """
        Simulates liquid balance day-by-day for 90 days.
        Returns (is_safe: bool, min_balance_reached: float)
        """
        additional_outflows = additional_outflows or {}
        disabled_events = disabled_events or set()
        reduced_events = reduced_events or {}

        current_balance = self.available_balance
        min_reached = current_balance

        for i in range(91):
            curr_date = start_date + timedelta(days=i)
            curr_date_str = format_date(curr_date)

            # Process scheduled events for this day
            for ev in self.events:
                if ev.get("status") in ["cancelled", "failed", "duplicate"]:
                    continue
                if ev.get("event_id") in disabled_events:
                    continue

                ev_date = parse_date(ev.get("event_date"))
                if ev_date == curr_date:
                    amt_str = ev.get("amount", "0")
                    if ev.get("event_id") in reduced_events:
                        amt_str = reduced_events[ev.get("event_id")]
                    
                    amt = self.convert_currency(amt_str, ev.get("currency", self.home_currency), curr_date_str)
                    t_type = ev.get("transaction_type")
                    
                    if t_type == "income":
                        current_balance += amt
                    elif t_type == "expense":
                        current_balance -= amt

            # Subtract any planned request outflows for today
            if curr_date in additional_outflows:
                current_balance -= additional_outflows[curr_date]

            if current_balance < min_reached:
                min_reached = current_balance

        return min_reached >= self.min_balance, min_reached

    def compute_amount_safe_to_pay(self, request_date, requested_amount):
        req_amt = float(requested_amount)
        # Scan downward in steps to find max safe immediate payment
        steps = min(int(req_amt), 50)
        step_size = req_amt / max(steps, 1)
        
        best_safe = 0.0
        for i in range(steps, -1, -1):
            test_amt = round(i * step_size, 2)
            outflows = {request_date: test_amt}
            is_safe, _ = self.simulate(request_date, additional_outflows=outflows)
            if is_safe:
                best_safe = test_amt
                break
        return best_safe

    def compute_earliest_full_payment_date(self, request_date, requested_amount):
        req_amt = float(requested_amount)
        for i in range(91):
            test_date = request_date + timedelta(days=i)
            outflows = {test_date: req_amt}
            is_safe, _ = self.simulate(request_date, additional_outflows=outflows)
            if is_safe:
                return format_date(test_date)
        return ""


