from datetime import datetime, timedelta

# ==========================================
# 1. HELPER FUNCTIONS & FORECAST ENGINE
# ==========================================

def parse_date(d_str):
    return datetime.strptime(d_str, "%Y-%m-%d").date()

def format_date(d_obj):
    return d_obj.strftime("%Y-%m-%d")

class CashFlowEngine:
    def __init__(self, user_profile, events, exchange_rates):
        self.user_id = user_profile['user_id']
        self.home_currency = user_profile['home_currency']
        self.initial_balance = float(user_profile['available_balance'])
        self.min_balance = float(user_profile['minimum_balance_to_keep'])
        self.events = events
        self.rates = exchange_rates

    def get_converted_amount(self, amount, currency, date_str):
        if currency == self.home_currency or not amount:
            return float(amount or 0.0)
        key = (date_str, currency, self.home_currency)
        rate = float(self.rates.get(key, 1.0))
        return float(amount) * rate

    def simulate_90_days(self, start_date, additional_outflows=None, disabled_events=None, reduced_events=None):
        """
        Simulates daily liquid balance over 90 days.
        additional_outflows: list of tuples (date_obj, amount)
        disabled_events: set of event_ids to ignore
        reduced_events: dict of {event_id: new_amount}
        """
        if additional_outflows is None:
            additional_outflows = []
        if disabled_events is None:
            disabled_events = set()
        if reduced_events is None:
            reduced_events = {}

        current_bal = self.initial_balance
        outflow_map = {}
        for d, amt in additional_outflows:
            outflow_map[d] = outflow_map.get(d, 0.0) + amt

        min_observed_balance = current_bal

        for i in range(91):
            curr_date = start_date + timedelta(days=i)
            curr_date_str = format_date(curr_date)

            # Process recurring/pending events scheduled for today
            for ev in self.events:
                if ev.get('status') in ['cancelled', 'failed', 'duplicate']:
                    continue
                if ev['event_id'] in disabled_events:
                    continue
                
                ev_date = parse_date(ev['event_date'])
                if ev_date == curr_date:
                    amt = float(ev['amount'])
                    if ev['event_id'] in reduced_events:
                        amt = reduced_events[ev['event_id']]
                    
                    amt_home = self.get_converted_amount(amt, ev.get('currency', self.home_currency), curr_date_str)
                    
                    if ev['transaction_type'] == 'income':
                        current_bal += amt_home
                    elif ev['transaction_type'] == 'expense':
                        current_bal -= amt_home

            # Subtract explicit plan outflows for today
            if curr_date in outflow_map:
                current_bal -= outflow_map[curr_date]

            if current_bal < min_observed_balance:
                min_observed_balance = current_bal

        return min_observed_balance >= self.min_balance, min_observed_balance

    def compute_amount_safe_to_pay(self, request_date, requested_amount):
        """Binary search to find max safe immediate payment without spending changes."""
        low, high = 0.0, float(requested_amount)
        best_safe = 0.0
        
        # Grid search in steps of 1.0 or binary search
        for step in range(int(high), -1, -5):
            amt = float(step)
            is_safe, _ = self.simulate_90_days(request_date, additional_outflows=[(request_date, amt)])
            if is_safe:
                return amt
        return 0.0

    def compute_earliest_full_payment_date(self, request_date, requested_amount):
        """Finds earliest date within 90 days where full requested_amount is safe as single payment."""
        amt = float(requested_amount)
        for i in range(91):
            test_date = request_date + timedelta(days=i)
            is_safe, _ = self.simulate_90_days(request_date, additional_outflows=[(test_date, amt)])
            if is_safe:
                return format_date(test_date)
        return ""

