import sys
import subprocess
from pathlib import Path

def main():
    script_dir = Path(__file__).parent
    agent_script = script_dir / "build_agent.py"
    
    print(f"Launching {agent_script}...")
    
    # Execute build_agent.py using the current Python interpreter
    result = subprocess.run([sys.executable, str(agent_script)], check=True)
    
    if result.returncode == 0:
        print("Successfully generated output.csv and evaluation/usage_report.md")

if __name__ == "__main__":
    main()
