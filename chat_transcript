def run_pipeline():
    loader = FinancialDatasetLoader("dataset")
    loader.load_all()

    output_rows = []
    headers = [
        "request_id",
        "amount_safe_to_pay",
        "affordability_status",
        "recommended_payment_method",
        "payment_plan",
        "earliest_date_for_full_payment",
        "spending_changes_needed",
        "decision_explanation"
    ]

    for req in loader.requests:
        req_id = req["request_id"]
        user_id = req["user_id"]
        req_date = parse_date(req["request_date"])
        req_amt = float(req["requested_amount"])
        completion_date = parse_date(req["desired_completion_date"])
        allows_partial = req.get("allows_partial_payment", "false").lower() == "true"

        profile = loader.profiles.get(user_id, {"home_currency": "USD", "available_balance": "0", "minimum_balance_to_keep": "0", "payment_methods_user_will_consider": "full_payment"})
        simulator = CashFlowSimulator(profile, loader.events, loader.exchange_rates)

        safe_today = simulator.compute_amount_safe_to_pay(req_date, req_amt)
        earliest_full = simulator.compute_earliest_full_payment_date(req_date, req_amt)
        earliest_full_date = parse_date(earliest_full) if earliest_full else None

        # Determine status & method
        status = "not_affordable"
        method = "not_recommended"
        plan = "none"
        spending_changes = "none"
        explanation = "Insufficient liquidity to cover the requested expense safely within the 90-day forecast."

        considered_methods = [m.strip() for m in profile.get("payment_methods_user_will_consider", "full_payment").split(",")]

        # Check full payment today
        if safe_today >= req_amt and "full_payment" in considered_methods:
            status = "affordable_now"
            method = "full_payment"
            plan = f"{format_date(req_date)}:{req_amt}"
            explanation = "Full payment is safe today without compromising the minimum balance."
        # Check partial payment
        elif allows_partial and safe_today > 0 and safe_today < req_amt and earliest_full_date and earliest_full_date <= completion_date and "partial_payment" in considered_methods:
            status = "affordable_with_plan"
            method = "partial_payment"
            remaining = round(req_amt - safe_today, 2)
            plan = f"{format_date(req_date)}:{safe_today}|{earliest_full}:{remaining}"
            explanation = "Partial payment today is safe, with the remaining balance covered by the earliest full payment date."
        # Check wait later
        elif earliest_full_date and "full_payment" in considered_methods:
            status = "affordable_later"
            method = "wait"
            plan = "none"
            explanation = f"Full payment becomes safe on {earliest_full}."

        output_rows.append({
            "request_id": req_id,
            "amount_safe_to_pay": safe_today,
            "affordability_status": status,
            "recommended_payment_method": method,
            "payment_plan": plan,
            "earliest_date_for_full_payment": earliest_full,
            "spending_changes_needed": spending_changes,
            "decision_explanation": explanation
        })

    # Write output.csv
    output_path = "output.csv"
